+       <strong class="{{ 'pos' if s.top_bottom.bottom_avg >= 0 else 'neg' }}">{{ s.top_bottom.bottom_avg | pct }}</strong>
+       ({{ s.top_bottom.bottom_symbols }}).</p>
+    {% endif %}
