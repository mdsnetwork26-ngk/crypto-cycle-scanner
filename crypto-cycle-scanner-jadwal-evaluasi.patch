+    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
+      <table>
+        <thead><tr><th class="l">Realisasi terbaik</th><th>n</th><th>Rata-rata</th><th>Arah benar</th></tr></thead>
+        <tbody>{% for c in s.coins_best %}
+          <tr><td class="l"><strong>{{ c.symbol }}</strong></td><td>{{ c.n }}</td>
+            <td class="pos">{{ c.avg | pct }}</td><td>{{ c.hit_pct | pct(False) }}</td></tr>{% endfor %}
+        </tbody>
+      </table>
+      {% if s.coins_worst %}
+      <table>
+        <thead><tr><th class="l">Realisasi terburuk</th><th>n</th><th>Rata-rata</th><th>Arah benar</th></tr></thead>
+        <tbody>{% for c in s.coins_worst %}
+          <tr><td class="l"><strong>{{ c.symbol }}</strong></td><td>{{ c.n }}</td>
+            <td class="neg">{{ c.avg | pct }}</td><td>{{ c.hit_pct | pct(False) }}</td></tr>{% endfor %}
+        </tbody>
+      </table>
+      {% endif %}
+    </div>
+    {% endif %}
+
+    {% if s.notes %}
+    <h3>📝 Catatan pola periode ini</h3>
+    <ul>{% for n in s.notes %}<li>{{ n }}</li>{% endfor %}</ul>
+    {% endif %}
+    {% endif %}
+  </div>
+  {% endfor %}
+
+  <div class="card">
+    <p class="mut">Metode: realisasi diambil dari candle harian tersimpan pada tanggal
+      jatuh tempo (toleransi 3 hari). Pemindaian yang horizonnya belum lewat tidak
+      dinilai — tidak ada penilaian prematur. Evaluasi ini menilai alatnya, bukan
