# Salin menjadi .env bila perlu mengubah bawaan
HOST=0.0.0.0
PORT=8020
DATABASE_PATH=data/scanner.db
# DEMO_MODE=true memakai data sintetis (untuk mencoba UI tanpa jaringan)
DEMO_MODE=false
# Koin acuan perpustakaan episode (yang tidak terdaftar di Indodax dilewati)
REFERENCE_SYMBOLS=BTC,ETH,BNB,SOL,XRP,DOGE,ADA,TRX,LINK,LTC,DOT,AVAX,ATOM,NEAR,UNI,AAVE,FIL,ALGO,XLM,ETC
# Jumlah pekerja unduhan paralel ke Indodax (jangan besar-besar)
FETCH_WORKERS=4
# Jadwal berkala: pindai SCHEDULED_HORIZONS tiap hari pukul
# SCHEDULE_HOUR:SCHEDULE_MINUTE (WIB), memakai ambang bawaan tombol manual.
SCHEDULE_ENABLED=false
SCHEDULED_HORIZONS=7,30,365
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
