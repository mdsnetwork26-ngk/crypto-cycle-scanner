+"""Instrumen audit untuk rubrik evaluasi 30 hari (BLOK 0).
+
+Modul ini TIDAK mengubah logika sinyal sama sekali. Ia hanya menambahkan
+metadata yang menjawab pertanyaan: "hasil ini dibuat oleh kode versi apa,
+dengan parameter apa, dan di atas data yang sehat atau tidak?"
+
+Tanpa tiga hal itu, evaluasi di hari ke-30 tidak bisa membedakan:
+  - sinyal salah  vs  data yang bolong
+  - model berubah  vs  hasil yang memang berubah
+  - skor turun karena pasar  vs  karena ada yang mengubah bobot
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import time
+from pathlib import Path
+
+_BASE_DIR = Path(__file__).resolve().parent.parent
+
+
+def _git_commit() -> str:
+    """Commit hash pendek; 'unknown' bila bukan repo git (mis. hasil salin .zip)."""
+    try:
+        out = subprocess.run(
+            ["git", "rev-parse", "--short", "HEAD"],
+            cwd=_BASE_DIR, capture_output=True, text=True, timeout=3,
+        )
+        return out.stdout.strip() or "unknown"
+    except Exception:  # noqa: BLE001 - audit tidak boleh menggagalkan pemindaian
+        return "unknown"
+
+
+# Dihitung sekali saat modul diimpor, bukan per kandidat.
+APP_VERSION = _git_commit()
+
+
+def config_hash(cfg: dict) -> str:
+    """Hash stabil dari parameter efektif.
+
+    sort_keys=True WAJIB: tanpa itu urutan dict bisa berbeda antar-run dan
+    hash tidak lagi bisa dipakai membandingkan dua pemindaian.
+    """
+    blob = json.dumps(cfg, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(blob).hexdigest()[:12]
+
+
+def quality_flags(candles: list[dict], *, btc_ok: bool,
+                  min_history_days: int = 730) -> list[str]:
+    """Tanda data bermasalah. List kosong = data bersih.
+
+    Ini yang membedakan "sinyal meleset" dari "datanya yang tidak lengkap".
+    Tanpa flag ini, keduanya terlihat sama di halaman evaluasi.
+    """
+    if not candles:
+        return ["no_candles"]
+
+    flags: list[str] = []
+    ts = [int(c["ts"]) for c in candles]
+
+    # Candle terakhir terlalu tua -> pemindaian memakai harga basi.
+    age_days = (int(time.time()) - ts[-1]) / 86400.0
+    if age_days > 2.0:
+        flags.append(f"stale_candle:{age_days:.1f}d")
+
+    # Lubang data: jarak antar candle jauh di atas 1 hari.
+    gaps = sum(1 for a, b in zip(ts, ts[1:]) if (b - a) > 1.5 * 86400)
+    if gaps:
+        flags.append(f"gap_days:{gaps}")
+
+    # Riwayat pendek -> fitur 365 hari dihitung dari posisi, bukan kalender.
+    if len(candles) < min_history_days:
+        flags.append(f"short_history:{len(candles)}d")
+
+    # BTC hilang -> rel_btc_90 diam-diam jadi 0.0 untuk semua kandidat.
+    if not btc_ok:
+        flags.append("btc_benchmark_missing")
+
+    return flags
+
+
+def build_audit_fields(*, cfg: dict, candles: list[dict], btc_ok: bool,
+                       ts_signal: int | None = None) -> dict:
+    """Kumpulan field audit untuk ditempel ke payload hasil."""
+    return {
+        "app_version": APP_VERSION,
+        "config_hash": config_hash(cfg),
+        "config_snapshot": cfg,
+        "ts_signal": int(ts_signal if ts_signal is not None else time.time()),
+        "ts_notify": None,          # belum ada kanal notifikasi
+        "data_quality_flags": quality_flags(candles, btc_ok=btc_ok),
+        "manual_override": None,    # diisi belakangan lewat baris baru
+    }
